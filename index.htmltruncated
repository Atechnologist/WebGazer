<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Mobile Gaze Tracker - Pure TFJS Engine</title>

    <!-- TensorFlow.js bundle (core + converter + webgl backend) -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.20.0/dist/tf.min.js"></script>
    <!-- face-detection is a required peer dependency of face-landmarks-detection's 'tfjs' runtime -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/face-detection@1.0.2/dist/face-detection.min.js"></script>
    <!-- Face landmarks model (MediaPipe FaceMesh, pure-JS runtime, gives 468 keypoints incl. iris/pupil) -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/face-landmarks-detection@1.0.6/dist/face-landmarks-detection.min.js"></script>

    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background-color: #111; font-family: sans-serif; }
        #webcam { position: absolute; width: 90px; height: 120px; bottom: 10px; right: 10px; border-radius: 8px; transform: scaleX(-1); border: 2px solid #333; z-index: 10; object-fit: cover; }
        .calib-dot { position: absolute; width: 40px; height: 40px; background-color: #ff3366; border-radius: 50%; transform: translate(-50%, -50%); display: none; z-index: 20; box-shadow: 0 0 15px #ff3366; }
        #gaze-pointer { position: absolute; width: 22px; height: 22px; background-color: #00ffcc; border-radius: 50%; transform: translate(-50%, -50%); display: none; z-index: 30; box-shadow: 0 0 10px #00ffcc; pointer-events: none; }
        #heatmap-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none; opacity: 0.6; }
        #ui-overlay { position: absolute; top: 45%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: white; z-index: 15; width: 80%; }
