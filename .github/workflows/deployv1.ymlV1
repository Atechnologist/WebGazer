name: Compile WebGazer and Deploy Pages

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build-and-compile:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository code
        uses: actions/checkout@v4

      - name: Set up NodeJS Environment
        uses: actions/setup-node@v4
        with:
          node-version: 18
          cache: 'npm'

      - name: Install dependencies
        run: |
          npm install filemanager-webpack-plugin@3.0.0 --save-dev
          npm install

      - name: Compile WebGazer assets
        run: npm run build

      - name: Staging Core Production Workspace
        run: |
          # Create isolation folder tree matching our script source targets
          mkdir -p _site
          mkdir -p _site/dist

          # WebGazer builds explicitly into dist/ based on package.json rules
          if [ -d "dist" ] && [ "$(ls -A dist)" ]; then
            cp -r dist/* _site/dist/
            echo "Successfully migrated distribution bundle compilation."
          else
            echo "ERROR: Webpack build step failed to output dist/ tracking artifacts."
            exit 1
          fi

          # Drop your clean root index into the isolated live web directory package 
          cp index.html _site/

          echo "=== PACKAGED ASSETS ==="
          ls -R _site

      - name: Upload Static Website Artifacts
        uses: actions/upload-pages-artifact@v3
        with:
          path: '_site'

  deploy-to-pages:
    needs: build-and-compile
    runs-on: ubuntu-latest
    
    permissions:
      pages: write
      id-token: write

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Deploy to Live Web URL
        id: deployment
        uses: actions/deploy-pages@v4
        
